  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tauri-apps/cli": "^2.12.4",
    "@types/aes-js": "^3.1.4",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "workbox-cli": "^7.4.1"
  },
  "scripts": {
    "postinstall": "powersync-web copy-assets -o public",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist/app && workbox generateSW workbox-config.js && node scripts/build-site.mjs",
    "deploy:web": "npm run build:web && npx vercel@latest deploy dist --prod",
    "build:desktop-web": "cross-env BOUTIK_DESKTOP=1 expo export --platform web --output-dir dist-desktop",
    "desktop": "tauri dev",
    "build:desktop": "tauri build",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p supabase/tests && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts"
  },
  "private": true
}
