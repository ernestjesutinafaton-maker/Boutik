{
  "expo": {
    "name": "Boutik",
    "slug": "boutik",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "boutik",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.boutik.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.boutik.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#059669",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-vector-icons/material-design-icons",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Boutik utilise l'appareil photo pour scanner les codes-barres des produits.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Boutik utilise l'appareil photo pour photographier les produits.",
          "photosPermission": "Boutik a besoin de tes photos pour choisir l'image d'un produit.",
          "microphonePermission": false
        }
      ],
      [
        "@ricka7x/expo-thermal-printer",
        {
          "bluetoothPermission": "Boutik utilise le Bluetooth pour imprimer les tickets de caisse."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "95d5a20f-3546-4e2e-a82c-516a120c689d"
      }
    },
    "owner": "ernest_afaton",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/95d5a20f-3546-4e2e-a82c-516a120c689d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
